{
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "dependencyDashboard": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "rebaseWhen": "conflicted",
  "autoApprove": true,
  "automerge": true,
  "separateMajorMinor": true,
  "separateMinorPatch": true,
  "separateMultipleMajor": true,
  "forkProcessing": "disabled",
  "ignoreDeprecated": false,
  "configMigration": true,
  "semanticCommitScope": "{{#if (equals packageFileDir '')}}root{{else}}{{{packageFileDir}}}{{/if}}",
  "additionalBranchPrefix": "{{#if (equals packageFileDir '')}}root{{else}}{{{packageFileDir}}}{{/if}}/",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}.{{{newMinor}}}.x",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "@company/script"
      ],
      "enabled": false
    },
    {
      "description": "Use published satantime images as the source for Node runtime updates",
      "matchDatasources": [
        "node-version"
      ],
      "overrideDatasource": "docker",
      "overridePackageName": "satantime/puppeteer-node"
    },
    {
      "description": "Keep the Node runtime and type declarations in one LTS update",
      "matchPackageNames": [
        "node",
        "satantime/puppeteer-node",
        "@types/node"
      ],
      "versioning": "node",
      "groupName": "Node.js",
      "groupSlug": "node",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "semanticCommitScope": "root",
      "additionalBranchPrefix": "root/"
    },
    {
      "matchFileNames": [
        ".circleci/config.yml"
      ],
      "semanticCommitScope": "root",
      "additionalBranchPrefix": "root/"
    }
  ]
}
